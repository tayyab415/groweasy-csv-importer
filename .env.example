# Copy to .env for local development. On Cloud Run these are set as env vars.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Optional: model + batching tuning
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BATCH_SIZE=25

# Optional: server port (Cloud Run sets PORT automatically)
PORT=3000
